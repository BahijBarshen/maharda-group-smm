NODE_ENV=development          # set to production when live
PORT=3000
BASE_URL=http://localhost:3000   # your public https URL in production
TRUST_PROXY=0                 # 1 if behind nginx/Cloudflare/etc
FORCE_HTTPS=0                 # 1 to redirect http -> https

# SMM provider (any panel with the standard "API v2"). Empty = demo services.
PROVIDER_API_URL=https://smmslim.com/api/v2
PROVIDER_API_KEY=FmCp1bNX41H0VlL5jekrjtXoqSzRocu1
MARKUP=0.5

# Security (production needs ADMIN_PASSWORD 12+ chars and SESSION_SECRET 32+ chars)
ADMIN_PASSWORD=bahijbarshen
SESSION_SECRET=bahij123

# Payments
CURRENCY=usd
MIN_DEPOSIT=5
MAX_DEPOSIT=500
STRIPE_SECRET_KEY=            # sk_live_... enables card payments
STRIPE_WEBHOOK_SECRET=        # whsec_... from your Stripe webhook endpoint

# Password recovery codes. Telegram is free and verifies the user's phone; WhatsApp is optional.
TELEGRAM_BOT_TOKEN=8635020945:AAE-ZGRInzXJs6QbYvmM6R317YbXLBHHJ9s          # create a bot with @BotFather and paste the token
WHATSAPP_TOKEN=               # Meta WhatsApp Cloud API access token
WHATSAPP_PHONE_ID=            # the sending number's Phone Number ID
WHATSAPP_TEMPLATE=            # name of your approved "authentication" template
WHATSAPP_LANG=en_US
    

# Sham Cash account shown to customers (optional; you can also edit it in Admin → Settings)
SHAMCASH_ACCOUNT=